# ==============================================================================
# AI REVENUE RECOVERY COMMAND CENTER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/ai_revenue_recovery?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ai_revenue_recovery

# AI Providers
# Google Gemini API Key (Gemini 2.5/Flash / Pro models)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Llama 3.3 70B / Mixtral for high-speed sub-second reasoning)
GROQ_API_KEY=your_groq_api_key_here

# Frontend Client URL for CORS & WebSocket Whitelisting
CLIENT_URL=http://localhost:5173
